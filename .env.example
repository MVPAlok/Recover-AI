# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/recoverai?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=development

# LLM Provider Configuration (Phase 4 Diagnosis Agent)
# Options: 'mock' (default, offline deterministic) or 'openai'
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Future Integrations (Planned for Phases 5 & 6)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
REDIS_URL="redis://localhost:6379"
