# ==============================================================================
# RecoverAI — Environment Variables & Deployment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
# Application URL for webhooks and CORS
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Connection string with SSL mode requirement
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.neon.tech/recoverai?sslmode=require"

# ------------------------------------------------------------------------------
# 3. ASYNCHRONOUS QUEUES & REDIS (BullMQ)
# ------------------------------------------------------------------------------
# Set to 'true' to enable BullMQ Redis background worker queue
ENABLE_REDIS=true
REDIS_URL="rediss://default:your_redis_token@your-redis-instance.upstash.io:6379"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY INTEGRATION (Razorpay TEST MODE ONLY)
# ------------------------------------------------------------------------------
# NOTE: RecoverAI operates strictly in TEST MODE. Do NOT provide Live Mode keys.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE & LLM DIAGNOSIS (Google Gemini 3.5 Flash)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai-compatible
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 6. FINANCIAL SAFETY & CIRCUIT BREAKER LIMITS
# ------------------------------------------------------------------------------
# Max automated retry attempts per merchant in rolling 24 hours
MERCHANT_DAILY_RETRY_BUDGET=250
# Consecutive failure rate threshold (0.60 = 60%) to trip gateway circuit breaker
CIRCUIT_BREAKER_FAIL_THRESHOLD=0.60
# Customer contact cooldown in hours
CUSTOMER_CONTACT_COOLDOWN_HOURS=24
