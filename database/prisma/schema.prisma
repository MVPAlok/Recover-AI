// RecoverAI Database Schema (Hardened Production-Grade Architecture)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  ANALYST
  SUPPORT
  VIEWER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships MerchantMembership[]

  @@map("users")
}

model Merchant {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      MerchantMembership[]
  customers        Customer[]
  transactions     Transaction[]
  payments         Payment[]
  aiDecisions      AIDecision[]
  recoveryAttempts RecoveryAttempt[]
  auditLogs        AuditLog[]

  @@map("merchants")
}

model MerchantMembership {
  id         String   @id @default(uuid())
  merchantId String
  userId     String
  role       UserRole @default(VIEWER)
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([merchantId])
  @@index([userId])
  @@map("merchant_memberships")
}

model Customer {
  id         String   @id @default(uuid())
  merchantId String

  name  String
  email String
  phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([merchantId, email])
  @@index([merchantId])
  @@map("customers")
}

enum TransactionStatus {
  FAILED
  PENDING
  SUCCESS
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  UNKNOWN
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum TransactionRecoveryStatus {
  NOT_STARTED
  IN_PROGRESS
  RECOVERED
  NOT_RECOVERED
  CANCELLED
  REQUIRES_REVIEW
}

model Transaction {
  id         String @id @default(uuid())
  merchantId String
  customerId String

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  status         TransactionStatus         @default(FAILED)
  paymentStatus  PaymentStatus             @default(FAILED)
  recoveryStatus TransactionRecoveryStatus @default(NOT_STARTED)
  paymentMethod  String?

  failureCode   String?
  failureReason String?

  retryCount Int @default(0)
  maxRetries Int @default(3)

  razorpayPaymentId String?
  razorpayOrderId   String?
  correlationId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments         Payment[]
  aiDecisions      AIDecision[]
  recoveryAttempts RecoveryAttempt[]
  auditLogs        AuditLog[]

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([recoveryStatus])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("transactions")
}

enum RecoveryDecision {
  RETRY
  REMIND
  ESCALATE
  WAIT
  STOP
}

enum AIAgentType {
  DETECTION
  DIAGNOSIS
  RECOVERY_DECISION
}

model AIDecision {
  id            String @id @default(uuid())
  merchantId    String
  transactionId String

  agentType AIAgentType
  decision  RecoveryDecision?

  recoveryProbability Float?
  confidenceScore     Float?

  failureCategory String?
  rootCause       String?
  riskLevel       String?
  riskFactors     Json?

  reasoning String?

  modelName     String?
  promptVersion String?
  isFallback    Boolean @default(false)
  latencyMs     Int?
  correlationId String?

  createdAt DateTime @default(now())

  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transaction      Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recoveryAttempts RecoveryAttempt[]

  @@index([merchantId])
  @@index([transactionId])
  @@index([agentType])
  @@index([correlationId])
  @@map("ai_decisions")
}

enum RecoveryStatus {
  PENDING
  EXECUTING
  SUCCESS
  FAILED
  CANCELLED
}

model RecoveryAttempt {
  id            String  @id @default(uuid())
  merchantId    String
  transactionId String
  aiDecisionId  String?

  attemptNumber  Int     @default(1)
  idempotencyKey String? @unique

  actionType RecoveryDecision
  status     RecoveryStatus   @default(PENDING)

  reason String?

  amountRecovered Decimal @default(0) @db.Decimal(12, 2)

  scheduledAt DateTime?
  executedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  correlationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant    Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  aiDecision  AIDecision? @relation(fields: [aiDecisionId], references: [id], onDelete: SetNull)
  payments    Payment[]
  auditLogs   AuditLog[]

  @@unique([transactionId, attemptNumber])
  @@index([merchantId])
  @@index([transactionId])
  @@index([status])
  @@index([correlationId])
  @@map("recovery_attempts")
}

model Payment {
  id                String  @id @default(uuid())
  merchantId        String
  transactionId     String
  recoveryAttemptId String?

  razorpayOrderId   String?
  razorpayPaymentId String?

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  status         PaymentStatus @default(UNKNOWN)
  capturedAmount Decimal?      @db.Decimal(12, 2)

  verified   Boolean @default(false)
  reconciled Boolean @default(false)

  failureCode   String?
  failureReason String?
  idempotencyKey String? @unique
  correlationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transaction     Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recoveryAttempt RecoveryAttempt? @relation(fields: [recoveryAttemptId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([transactionId])
  @@index([recoveryAttemptId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([status])
  @@index([reconciled])
  @@index([correlationId])
  @@map("payments")
}

model AuditLog {
  id                String  @id @default(uuid())
  merchantId        String
  transactionId     String?
  recoveryAttemptId String?

  entityType String
  entityId   String
  action     String

  actor         String?
  actorType     String?
  requestId     String?
  correlationId String?
  ipAddress     String?
  userAgent     String?
  details       Json?

  createdAt DateTime @default(now())

  merchant        Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transaction     Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  recoveryAttempt RecoveryAttempt? @relation(fields: [recoveryAttemptId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([transactionId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum WebhookProcessingStatus {
  RECEIVED
  VERIFIED
  PROCESSING
  PROCESSED
  FAILED
  RETRYING
  DEAD_LETTER
}

model RazorpayWebhookEvent {
  id                String                  @id @default(uuid())
  eventId           String                  @unique
  eventType         String
  payload           Json
  status            WebhookProcessingStatus @default(RECEIVED)
  signatureVerified Boolean                 @default(false)

  merchantId        String?
  transactionId     String?
  razorpayOrderId   String?
  razorpayPaymentId String?

  errorMessage   String?
  retryCount     Int                     @default(0)
  lastRetriedAt  DateTime?
  processedAt    DateTime?
  correlationId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([eventType])
  @@index([status])
  @@index([transactionId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("razorpay_webhook_events")
}
