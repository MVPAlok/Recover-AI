{
  "name": "recoverai-root",
  "version": "0.1.0",
  "private": true,
  "description": "RecoverAI — AI Revenue Recovery Agent",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "lint": "npm run lint --workspaces",
    "prisma:generate": "npx prisma generate --schema=database/prisma/schema.prisma",
    "prisma:validate": "npx prisma validate --schema=database/prisma/schema.prisma",
    "db": "tsx database/seed/seed.ts",
    "db:seed": "tsx database/seed/seed.ts",
    "detection:eval": "tsx server/src/modules/detection/evaluation-runner.ts",
    "test:detection": "tsx server/src/modules/detection/evaluation-runner.ts",
    "test:unit": "tsx server/src/modules/detection/__tests__/detection.test.ts",
    "diagnosis:eval": "tsx server/src/modules/diagnosis/evaluation-runner.ts",
    "test:diagnosis": "tsx server/src/modules/diagnosis/__tests__/diagnosis.test.ts",
    "decision:eval": "tsx server/src/modules/recovery-decision/evaluation-runner.ts",
    "test:decision": "tsx server/src/modules/recovery-decision/__tests__/recovery-decision.test.ts",
    "executor:eval": "tsx server/src/modules/recovery-executor/evaluation-runner.ts",
    "test:executor": "tsx server/src/modules/recovery-executor/__tests__/recovery-executor.test.ts",
    "test:idempotency": "tsx server/src/modules/recovery-executor/__tests__/idempotency.test.ts",
    "test:safety": "tsx server/src/modules/recovery-executor/__tests__/safety.test.ts",
    "test:razorpay": "tsx server/src/integrations/razorpay/__tests__/razorpay-client.test.ts",
    "test:webhooks": "tsx server/src/modules/webhooks/__tests__/webhook.test.ts",
    "test:provider-selection": "tsx server/src/modules/recovery-executor/__tests__/provider-selection.test.ts",
    "test:queue": "tsx server/src/modules/queue/__tests__/queue.test.ts",
    "queue:eval": "tsx server/src/modules/queue/evaluation-runner.ts",
    "test:dashboard": "tsx server/src/modules/dashboard/__tests__/dashboard.test.ts",
    "test:system": "tsx server/src/modules/system/__tests__/system-health.test.ts",
    "test:all": "tsx server/src/modules/detection/__tests__/detection.test.ts && tsx server/src/modules/diagnosis/__tests__/diagnosis.test.ts && tsx server/src/modules/recovery-decision/__tests__/recovery-decision.test.ts && tsx server/src/modules/recovery-executor/__tests__/recovery-executor.test.ts && tsx server/src/modules/webhooks/__tests__/webhook.test.ts && tsx server/src/modules/dashboard/__tests__/dashboard.test.ts && tsx server/src/modules/queue/__tests__/queue.test.ts && tsx server/src/modules/system/__tests__/system-health.test.ts",
    "simulation:failure": "tsx server/src/scripts/production-failure-simulation.ts",
    "razorpay:eval": "tsx server/src/modules/razorpay/evaluation-runner.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "concurrently": "^8.2.2",
    "prisma": "^7.9.1",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "pg": "^8.23.0"
  }
}
